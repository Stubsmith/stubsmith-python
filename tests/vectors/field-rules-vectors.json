{
  "_comment": "Golden test vectors for the shared field-rules masker (browser JS + Python SDK). Each vector drives compile_field_rules / apply_field_rules / apply_resp_field_rules. Comparison rules: (1) When input content_type normalises to application/json, compare masked_body by parsing both sides as JSON (json.loads / JSON.parse) so that key-ordering and spacing differences between json.dumps and JSON.stringify are irrelevant. (2) When input content_type normalises to application/x-www-form-urlencoded, compare masked_body as a parsed param map (urllib.parse.parse_qs / URLSearchParams iteration) stored here as {name: [values]} - urlencode vs URLSearchParams ordering and percent-encoding can differ. (3) For opaque (non-JSON, non-form) bodies, compare masked_body as a plain string. (4) masked_query is always stored as a parsed param map {name: [values]} and compared after parsing the actual output string. (5) masked_headers and masked_resp_headers are compared as plain string→string dicts.",
  "vectors": [
    {
      "name": "all-scalars-masked",
      "description": "No keep rules. JSON body with all four scalar types: string→<masked>, number→0, bool→false, null→null (type-appropriate placeholders).",
      "field_rules": [],
      "input": {
        "body": "{\"str\":\"hello\",\"num\":42,\"flag\":true,\"nil\":null}",
        "content_type": "application/json",
        "headers": {"content-type": "application/json"},
        "query": "",
        "resp_body": "",
        "resp_content_type": "",
        "resp_headers": {}
      },
      "expected": {
        "masked_body": {"str": "<masked>", "num": 0, "flag": false, "nil": null},
        "masked_headers": {"content-type": "application/json"},
        "masked_query": {},
        "masked_resp_body": "",
        "masked_resp_headers": {}
      }
    },
    {
      "name": "body-nested-dict-keep",
      "description": "body. namespace: keep a nested path (body.user.plan). Other paths masked. Shows dict recursion with .key segments.",
      "field_rules": [
        {"path": "body.user.plan", "action": "keep"}
      ],
      "input": {
        "body": "{\"user\":{\"plan\":\"pro\",\"token\":\"secret\"}}",
        "content_type": "application/json",
        "headers": {"content-type": "application/json"},
        "query": "",
        "resp_body": "",
        "resp_content_type": "",
        "resp_headers": {}
      },
      "expected": {
        "masked_body": {"user": {"plan": "pro", "token": "<masked>"}},
        "masked_headers": {"content-type": "application/json"},
        "masked_query": {},
        "masked_resp_body": "",
        "masked_resp_headers": {}
      }
    },
    {
      "name": "body-array-all-elements",
      "description": "Body walk: arrays iterate ALL elements through the [] segment. Keep body.items.[].id; secret masked for every element.",
      "field_rules": [
        {"path": "body.items.[].id", "action": "keep"}
      ],
      "input": {
        "body": "{\"items\":[{\"id\":1,\"secret\":\"a\"},{\"id\":2,\"secret\":\"b\"}]}",
        "content_type": "application/json",
        "headers": {},
        "query": "",
        "resp_body": "",
        "resp_content_type": "",
        "resp_headers": {}
      },
      "expected": {
        "masked_body": {"items": [{"id": 1, "secret": "<masked>"}, {"id": 2, "secret": "<masked>"}]},
        "masked_headers": {},
        "masked_query": {},
        "masked_resp_body": "",
        "masked_resp_headers": {}
      }
    },
    {
      "name": "null-stays-null-without-keep",
      "description": "null scalar at a non-kept path returns null (not <masked>). The null placeholder is null itself - returned before checking the keep set.",
      "field_rules": [],
      "input": {
        "body": "{\"value\":null,\"str\":\"hello\"}",
        "content_type": "application/json",
        "headers": {},
        "query": "",
        "resp_body": "",
        "resp_content_type": "",
        "resp_headers": {}
      },
      "expected": {
        "masked_body": {"value": null, "str": "<masked>"},
